        "preemption": {
            "restart_cost": 0.45,
            "relevance_scale": 1.0,
            "context_scale": 0.25,
            "min_improvement_score": 0.25,
            "max_preemptions_per_query": 2
        }
    },
    "rag": {
        "enabled": true,
        "prefetch_enabled": true,
        "first_token_budget_ms": 120,
        "top_k": 3,
        "max_snippets": 3,
        "pressure_threshold_pct": 82,
        "pressure_relief_pct": 72,
        "pressure_top_k": 1,
        "adaptive": {
            "budget_min_ms": 40,
            "budget_max_ms": 280
        },
        "graph_first": {
            "enabled": true,
            "min_confidence": 0.68,
            "min_snippets": 2,
            "project_boost": 0.12,
            "relevance_validation_min": 0.74
