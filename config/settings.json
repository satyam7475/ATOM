{
    "deployment": {
        "profile": "personal_desktop",
        "dashboard_badge": true,
        "product_tier": "balanced"
    },
    "session": {
        "enabled": true,
        "max_query_snippet_chars": 120
    },
    "skills": {
        "enabled": true,
        "path": "config/skills.json"
    },
    "owner": {
        "name": "Satyam",
        "title": "Boss"
    },
    "vision": {
        "enabled": false,
        "camera_index": 0,
        "check_interval_seconds": 5,
        "require_owner_for_sensitive": false,
        "owner_encoding_path": "config/owner_face.npy"
    },
    "mic": {
        "device_name": null,
        "prefer_bluetooth": false
    },
    "audio_intelligence": {
        "enabled": true,
        "auto_select": true,
        "active_test_duration_s": 2.0,
        "allow_bluetooth": true,
        "bluetooth_penalty": 0.1,
        "min_rms_threshold_db": -80,
        "monitoring_interval_s": 15,
        "degradation_checks_before_switch": 4,
        "voice_feedback": true,
        "prefer_device": null,
        "vad_aggressiveness": 2,
        "set_system_default": true,
        "debug_logging": false,
        "context_aware": true,
        "device_learning": true,
        "predictive_switching": false,
        "predictive_rms_slope_threshold": -0.5,
        "predictive_snr_slope_threshold": -0.3,
        "night_suppress_feedback": true,
        "low_confidence_ask_user": true
    },
    "stt": {
        "engine": "macos_native",
        "locale": "auto",
        "whisper_model_size": "base",
        "bilingual": true,
        "sample_rate": 16000,
        "chunk_size": 2048,
        "post_tts_cooldown_ms": 1000,
        "preload": true,
        "calibration_delay_s": 2.0,
        "min_energy_threshold": 400,
        "whisper_vad": {
            "speech_pad_ms": 400,
            "min_silence_duration_ms": 220,
            "threshold": 0.32
        },
        "min_audio_duration_s": 0.42,
        "audio_buffer_frames": 2048,
        "native_stop_audio_delay_ms": 120,
        "voice_debug": true,
        "voice_debug_interval_s": 30,
        "barge_in_during_speak": false,
        "native_requires_on_device": true,
        "native_voice_processing": true,
        "native_tap_sample_rate": 0
    },
    "tts": {
        "engine": "macos_native",
        "max_lines": 4,
        "macos_voice": "system",
        "macos_rate": 165,
        "edge_voice": "en-GB-SoniaNeural",
        "edge_rate": "+0%",
        "edge_postprocess": true,
        "edge_ack_cache": true
    },
    "context": {
        "enable_clipboard": true,
        "enable_active_window": true,
        "clipboard_max_chars": 400
    },
    "cache": {
        "max_size": 128,
        "ttl_seconds": 300
    },
    "memory": {
        "graph_db_path": "data/atom_memory.db",
        "max_entries": 500,
        "top_k": 3,
        "max_vector_results": 5,
        "max_graph_nodes": 1000,
        "pressure_threshold_pct": 82,
        "pressure_relief_pct": 72,
        "pressure_top_k": 2,
        "pressure_query_limit": 3,
        "semantic_weight": 0.7,
        "v7_scoring": {
            "enabled": true,
            "recency_weight": 0.3,
            "importance_weight": 0.3,
            "success_rate_weight": 0.2,
            "similarity_weight": 0.2
        }
    },
    "brain": {
        "enabled": true,
        "model_path": "models/qwen3-8b-q4_k_m.gguf",
        "mlx_primary_model": "models/qwen3-4b-mlx",
        "mlx_fast_model": "models/qwen3-4b-mlx",
        "mlx_default_role": "fast",
        "n_ctx": 4096,
        "n_threads": 4,
        "n_gpu_layers": -1,
        "n_batch": 256,
        "max_tokens": 320,
        "temperature": 0.65,
        "top_p": 0.9,
        "repeat_penalty": 1.1,
        "timeout_seconds": 22
    },
    "assistant_brain": {
        "active_profile": "optimal",
        "restore_persisted_profile": true,
        "persist_active_profile": true,
        "audit_profile_changes": true,
        "quick_replies_enabled": true,
        "quick_replies": {
            "how are you": "I'm good, Boss. Systems nominal and ready.",
            "hello atom": "Yes, Boss? What do you need?",
            "hey atom": "Listening, Boss.",
            "thank you": "Anytime, Boss.",
            "thanks atom": "Happy to help, Boss.",
            "good morning atom": "Good morning, Boss. Ready to work.",
            "good night atom": "Good night, Boss. I'll keep watch.",
            "what's up": "All systems green, Boss. Ready for your command.",
            "are you there": "I'm here, Boss. Always listening.",
            "tell me a joke": "Why do programmers prefer dark mode? Because light attracts bugs.",
            "you're smart": "Thanks Boss, I try my best.",
            "i'm bored": "Want me to open something for you, Boss? Or set a new goal?",
            "what should i do": "Check your goals, Boss. Say 'show goals' to see what's pending.",
            "do you sleep": "I don't sleep, Boss. I'm always ready.",
            "status report": "All systems nominal. CPU cool, memory clean, brain loaded."
        },
        "profiles": {
            "optimal": {
                "max_tokens": 256,
                "n_ctx": 4096,
                "n_threads": 4,
                "n_gpu_layers": -1,
                "n_batch": 256,
                "timeout_seconds": 16,
                "temperature": 0.6,
                "extra_stop_sequences": ["\n\nUser:", "\nUser:", "\n\nBoss:"]
            },
            "full_performance": {
                "max_tokens": 512,
                "n_ctx": 10240,
                "n_threads": 4,
                "n_gpu_layers": -1,
                "n_batch": 512,
                "timeout_seconds": 28,
                "temperature": 0.65
            }
        }
    },
    "ui": {
        "mode": "web",
        "web_port": 8765,
        "auto_open_browser": true,
        "password_auth_enabled": false,
        "voice_only_input": false,
        "jarvis_boot_splash": true
    },
    "executor": {
        "max_workers": 2
    },
    "developer": {
        "role": "Personal AI Operating System",
        "focus": "system management, desktop automation, productivity",
        "project_name": "ATOM OS"
    },
    "security": {
        "mode": "strict",
        "audit_to_file": true,
        "require_confirmation_for": [
            "shutdown_pc", "restart_pc", "logoff", "sleep_pc",
            "empty_recycle_bin", "kill_process", "close_app",
            "open_url", "play_youtube", "lock_screen", "screenshot",
            "move_path", "copy_path", "create_folder"
        ]
    },
    "features": {
        "desktop_control": true,
        "file_ops": true,
        "llm": true,
        "system_analyze": true,
        "web_research": false,
        "online_weather": false,
        "proactive_awareness": true
    },
    "control": {
        "lock_mode": "off",
        "assistant_mode": "conversational",
        "allow_runtime_mode_switch": true,
        "persist_assistant_mode": true,
        "restore_persisted_assistant_mode": true,
        "audit_assistant_mode_changes": true,
        "command_only_message": "Command-only mode is on, Boss — no chat brain for open questions. Try time, cpu, open notepad, or say hybrid mode to bring the brain back."
    },
    "performance": {
        "mode": "auto",
        "auto_threshold_high": 78,
        "auto_threshold_mid": 45,
        "health_check_interval_s": 120,
        "stuck_state_threshold_s": 75,
        "system_watcher_interval_s": 30,
        "maintenance_interval_s": 180,
        "proactive_alerts": false,
        "idle_reminder": false,
        "cpu_governor": true,
        "cpu_governor_threshold": 75,
        "watchdog_thinking_timeout_s": 120,
        "watchdog_speaking_timeout_s": 300,
        "watchdog_intent_timeout_ms": 50,
        "watchdog_cache_timeout_ms": 100,
        "watchdog_rag_timeout_ms": 500,
        "watchdog_llm_timeout_s": 30,
        "watchdog_tts_timeout_s": 30,
        "watchdog_tool_timeout_s": 10,
        "supervisor_restart_cooldown_s": 8,
        "watchdog_poll_interval_s": 2,
        "use_priority_scheduler": true
    },
    "autonomy": {
        "enabled": true,
        "auto_execute_threshold": 0.95,
        "suggest_threshold": 0.72,
        "idle_timeout_minutes": 10,
        "habit_decay_days": 7,
        "habit_decay_rate": 0.02,
        "max_habits": 50,
        "check_interval_s": 90,
        "log_all_decisions": true
    },
    "cognitive": {
        "enabled": true,
        "goals_enabled": true,
        "predictions_enabled": true,
        "behavior_model_enabled": false,
        "self_optimizer_enabled": true,
        "prediction_check_interval_s": 300,
        "behavior_update_interval_s": 1800,
        "goal_evaluation_interval_s": 3600,
        "prediction_min_confidence": 0.65,
        "prediction_preload_enabled": false,
        "prediction_preload_min_confidence": 0.82,
        "prediction_preload_max_items": 1,
        "prediction_preload_cooldown_s": 180,
        "prediction_preload_timeout_s": 1.5,
        "auto_mode_switching": true,
        "default_mode": "work",
        "max_goals": 15,
        "max_predictions": 4,
        "optimizer_check_interval_s": 7200,
        "energy_inference_interval_s": 180,
        "dream_enabled": false,
        "dream_idle_minutes": 45,
        "dream_interval_hours": 6,
        "curiosity_enabled": false,
        "curiosity_max_per_hour": 1,
        "curiosity_cooldown_minutes": 45,
        "goal_tool_auto_complete": true,
        "goal_tool_match_strict": false,
        "dream_require_idle_signal": true,
        "dream_min_interactions": 5,
        "dream_prune_second_brain": true,
        "dream_prewarm_embeddings": false,
        "dream_prewarm_retrieve_topics": ["work", "ATOM", "project", "schedule", "personal"]
    },
    "proactive_coordination": {
        "max_insights_per_hour": 20,
        "critical_priority_max": 3,
        "audit_log": true,
        "audit_log_path": "logs/proactive_insights.log",
        "window_seconds": 3600
    },
    "proactive_engine": {
        "check_interval_s": 900,
        "m5_triggers": {
            "enabled": true,
            "battery_low_pct": 20,
            "memory_high_pct": 82,
            "disk_free_gb_warn": 10,
            "project_stale_days": 3,
            "idle_goal_nudge_minutes": 40,
            "morning_briefing_hours": [7, 8, 9]
        }
    },
    "conversation_memory": {
        "max_turns": 20
    },
    "embedding": {
        "model": "all-MiniLM-L6-v2",
        "dimension": 384,
        "device": "auto"
    },
