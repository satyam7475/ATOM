    "latency_controller": {
        "direct_budget_ms": 50,
        "cache_budget_ms": 100,
        "quick_budget_ms": 1500,
        "full_budget_ms": 5000,
        "deep_budget_ms": 15000,
        "simple_query_max_chars": 48,
        "memory_pressure_pct": 82,
        "low_battery_pct": 20,
        "cpu_busy_pct": 88,
        "battery_scale": 0.9,
        "low_battery_scale": 0.72,
        "thermal_scale": 0.68,
        "memory_scale": 0.75,
        "cpu_scale": 0.82,
        "simple_scale": 0.84,
        "deep_scale": 1.08,
        "rag_fraction_full": 0.16,
        "rag_fraction_deep": 0.24,
        "rag_min_ms": 60,
        "rag_max_ms": 650
