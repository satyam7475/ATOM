    "v7_gpu": {
        "enabled": true,
        "strict_control": false,
        "deployment_mode": "distributed",
        "vram_reserve_mb": 512,
        "model_slots_mb": {
            "llm": 6144,
            "stt": 1536,
            "embeddings": 384
        },
        "eviction_order": ["embeddings", "stt", "llm"],
        "idle_unload_stt_s": 30,
        "idle_unload_llm_s": 90,
        "idle_sleep_s": 600,
        "fused_gpu_worker": false,
        "gpu_stall_timeout_s": 120,
        "allow_cuda_reset": false,
        "degradation_default": "limited",
