        "smart_scoring": {
            "recency_half_life_hours": 168,
            "owner_priority_multiplier": 2.0,
            "owner_priority_sources": ["preference", "voice", "owner", "boss", "user"],
            "usage_boost_max": 0.12,
            "usage_history_size": 4096,
            "stale_after_hours": 1080,
            "time_sensitive_stale_after_hours": 168,
            "stale_penalty": 0.18
