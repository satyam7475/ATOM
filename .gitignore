# User credentials and secrets
~/.atom/
.atom/
credentials/
secrets/
*.enc
*.key
.mk

# API keys (if accidentally created in repo)
api_keys.json
gemini_keys.json
credentials.json

# Environment files with credentials
.env.local
.env.credentials

# Master password backup files
.master_password*
password_backup*

# OS secrets
.DS_Store
*.pem
*.p12

# Cross-device pairing tokens (iPhone bridge etc.) — runtime-rotated secrets
config/bridge_token
data/trusted_iphone.json

# macOS app bundle codesigning churn (rebuilt by `scripts/build_atom_app_launcher.sh`)
ATOM.app/Contents/_CodeSignature/
ATOM.app/Contents/MacOS/atom_python
