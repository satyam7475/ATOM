# Runtime data (SQLite, caches, security vault, voice profiles, vector DB)
data/
atom_vector_db/

# Logs and test output
logs/
*.log
atomlogs.txt
.test_results/

# Data backups
data_backup_*/

# Environment
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# IDE / workspace
.vscode/
.idea/
# Ignore Cursor runtime/cache (logs, indexes), but back up the
# project-level engineering knowledge that lives next to the code:
#   .cursor/rules/   -- agent behaviour contracts
#   .cursor/skills/  -- reusable agent skills + scripts
.cursor/*
!.cursor/rules/
!.cursor/skills/

# Models (too large for GitHub -- re-downloadable)
models/*.gguf
models/vosk-*/
models/*.onnx
models/*-mlx/
models/*-mlx-*/
models/qwen3-*/
models/qwen2*/
models/Qwen*/
models/smolvlm-*/
models/*-vlm-*/
models/*-instruct-*/
models/*.safetensors
models/*.npz
# Sprint Ω: whisper.cpp GGML weights (~190 MB) and Kokoro neural TTS
# weights (~310 MB ONNX + 24 MB voices). Re-downloadable via the
# install scripts (see scripts/install_whisper_model.py and
# scripts/install_kokoro.py), so keep them out of git.
models/ggml-*.bin
models/ggml-*.bin.sha256
models/kokoro/

# macOS
.DS_Store

# Temp / audio
*.tmp
*.mp3

# OS
Thumbs.db
desktop.ini

