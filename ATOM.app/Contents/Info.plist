<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>ATOM</string>
	<key>CFBundleDisplayName</key>
	<string>ATOM - Personal AI OS</string>
	<key>CFBundleIdentifier</key>
	<string>com.satyam.atom</string>
	<key>CFBundleVersion</key>
	<string>19.0</string>
	<key>CFBundleShortVersionString</key>
	<string>19.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>atom_launcher</string>
	<key>CFBundleIconFile</key>
	<string>atom</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- TCC usage descriptions — required for SFSpeechRecognizer + Mic -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>ATOM uses on-device speech recognition to understand your voice commands. All processing happens locally on the Neural Engine — nothing is sent to any server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ATOM needs microphone access to listen for your voice commands and wake word. Audio is processed entirely on-device.</string>

	<!-- Accessibility for desktop control -->
	<key>NSAppleEventsUsageDescription</key>
	<string>ATOM uses AppleScript to control applications and automate tasks on your behalf.</string>

	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
